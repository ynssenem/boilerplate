{
  "name": "@repo/api",
  "private": true,
  "version": "0.0.0",
  "types": "./dist/entry.d.ts",
  "main": "./dist/entry.js",
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "require": "./dist/entry.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b -v",
    "dev": "pnpm build --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/mapped-types": "^2.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:backenddev",
    "ts-loader": "catalog:backenddev",
    "ts-node": "catalog:backenddev",
    "typescript": "catalog:backenddev"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist/**"
  ]
}
