{
  "name": "api",
  "private": true,
  "version": "alpha-1.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "catalog:backend",
    "@nestjs/core": "catalog:backend",
    "@nestjs/platform-express": "catalog:backend",
    "@repo/api": "workspace:*",
    "reflect-metadata": "catalog:backend",
    "rxjs": "catalog:backend"
  },
  "devDependencies": {
    "@jest/globals": "catalog:backenddev",
    "@nestjs/cli": "catalog:backenddev",
    "@nestjs/schematics": "catalog:backenddev",
    "@nestjs/testing": "catalog:backenddev",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "catalog:backenddev",
    "@types/node": "catalog:backenddev",
    "@types/supertest": "catalog:backenddev",
    "jest": "catalog:backenddev",
    "source-map-support": "catalog:backenddev",
    "supertest": "catalog:backenddev",
    "ts-jest": "catalog:backenddev",
    "ts-loader": "catalog:backenddev",
    "ts-node": "catalog:backenddev",
    "tsconfig-paths": "catalog:backenddev",
    "typescript": "catalog:backenddev"
  }
}
